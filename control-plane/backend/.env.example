# Development-only configuration. Never reuse these credentials outside local development.
CONTROL_PLANE_NAME="MC-IaaS Control Plane"
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001

DATABASE_URL=postgresql+asyncpg://mc_iaas:development-only@127.0.0.1:5432/mc_iaas

AGENT_CONNECT_TIMEOUT=5
AGENT_READ_TIMEOUT=30

NODE_POLL_INTERVAL=10
NODE_OFFLINE_THRESHOLD=30
NODE_MAX_BACKOFF=300

RECONCILIATION_INTERVAL=15
RECONCILIATION_RETRY_LIMIT=3

LOG_LEVEL=INFO
